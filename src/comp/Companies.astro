---
import { companies } from "./data";
---

<div>
    <h2 class="my-6 heading text-4xl">I've worked for</h2>
</div>
<section class="">
    <div data-glare-box class="bg-white/10 p-8 mb-20 [background-image:radial-gradient(circle_at_var(--refl-x,50%)_var(--refl-y,50%),rgba(255,255,255,0.22),rgba(255,255,255,0)_240px)]">
        <ul
            class="grid sm:grid-cols-[repeat(auto-fill,240px)] place-content-center gap-4 lg:gap-10 place-items-center"
        >
            {
                companies.map((comp) => (
                    <li class=" ">
                        <a
                            href={comp.url}
                            target="_blank"
                            rel=" noopener noreferrer"
                        >
                            <img
                                class=" w-full max-h-[80px]  md:max-h-[120px] "
                                src={`/portfolio${comp.img}`}
                                alt={`${comp.name} company logo`}
                                title={comp.name}
                            />
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</section>
